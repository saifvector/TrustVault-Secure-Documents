# TrustVault environment configuration
# Copy this file to `.env` and fill in the values for your own backend.
# NEVER commit your real `.env` — it is gitignored.

# --- Backend connection (Lovable Cloud / Supabase-compatible) ---

# Your backend project reference ID.
SUPABASE_PROJECT_ID="your-project-ref"

# Publishable (anon) key. Safe to expose to the browser — it is protected
# by row-level security. NEVER put a service-role key in a VITE_* variable.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Backend API URL.
SUPABASE_URL="https://your-project-ref.supabase.co"

# Browser-exposed copies of the same public values (Vite inlines VITE_*).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# --- Server-only secrets (never exposed to the browser) ---

# Service-role key. Used only inside server functions for privileged writes
# after server-side authorization checks. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Secret used to authenticate scheduled (cron) HTTP calls, if you add any.
LOVABLE_CRON_SECRET="generate-a-long-random-string"
